{
  "name": "@agent-console/desktop",
  "version": "0.1.0",
  "private": true,
  "author": "Tang Agent Dashboard",
  "description": "Tang Agent Dashboard 桌面壳：Electron 包 daemon + UI",
  "main": "dist/main.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "build:watch": "tsc -p tsconfig.json --watch",
    "start": "npm run build && electron .",
    "start:fast": "electron .",
    "dev": "electron . --dev",
    "stage": "node scripts/stage.mjs",
    "package": "npm run stage && electron-builder --linux --x64 --config.npmRebuild=false",
    "package:dir": "npm run stage && electron-builder --linux --x64 --dir --config.npmRebuild=false"
  },
  "dependencies": {
    "tree-kill": "^1.2.2"
  },
  "devDependencies": {
    "electron": "35.7.5",
    "electron-builder": "^24.13.3",
    "typescript": "^5.6.0"
  }
}