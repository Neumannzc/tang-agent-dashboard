{
  "name": "agent-console",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build -w @agent-console/protocol && npm run build -w @agent-console/daemon && npm run build -w @agent-console/ui && npm run build -w @agent-console/desktop",
    "typecheck": "npm run build",
    "test": "npm run test -w @agent-console/daemon",
    "build:desktop": "npm run build -w @agent-console/desktop",
    "dev": "node scripts/dev.mjs",
    "dev:ui": "npm run dev -w @agent-console/ui",
    "start": "npm run start -w @agent-console/desktop",
    "desktop": "npm run build && npm run start",
    "e2e:desktop": "npm run build && node scripts/e2e-desktop.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "allowScripts": {
    "esbuild@0.28.1": true
  },
  "devDependencies": {
    "playwright-core": "^1.62.1"
  }
}
